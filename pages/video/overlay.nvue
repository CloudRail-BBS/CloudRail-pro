<template>
  <div class="overlay" :class="themeClass">
    <!-- 顶部渐变 -->
    <div class="top-gradient"></div>
    <!-- 底部渐变 -->
    <div class="bottom-gradient"></div>

    <!-- 顶部按钮栏 -->
    <div class="top-bar" :style="{ paddingTop: statusBarHeight + 'px' }">
      <div class="top-btn" @click="goBack">
        <text class="back-text">‹</text>
      </div>
      <div class="top-btn" @click="openActionSheet">
        <div class="dots">
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
      </div>
    </div>

    <!-- 中央播放按钮 -->
    <div v-if="!isPlaying" class="center-play" @click="togglePlay">
      <div class="play-btn">
        <text class="play-icon">▶</text>
      </div>
    </div>

    <!-- 右侧操作栏 -->
    <div class="side-actions">
      <div class="avatar-outer" @click="toUserHome">
        <div class="avatar-wrap">
          <image class="avatar" :src="postInfo.avatar || '/static/logo.png'" mode="aspectFill"></image>
        </div>
      </div>
      <div v-if="showFollowBtn" class="follow-plus" @click="handleFollow">
        <text class="plus-text">+</text>
      </div>
      <div class="action-item" @click="handleLike">
        <image class="action-icon" :src="isLiked ? '/static/post/xih1.png' : '/static/post/xih0.png'" mode="aspectFit"></image>
        <text class="action-text">{{ formatCount(postInfo.like_count) }}</text>
      </div>
      <div class="action-item" @click="openCommentDrawer">
        <image class="action-icon" src="/static/post/pl.png" mode="aspectFit"></image>
        <text class="action-text">{{ formatCount(commentCount) }}</text>
      </div>
      <div class="action-item" @click="openRewardModal">
        <image class="action-icon gift" src="/static/icon/gift-white.svg" mode="aspectFit"></image>
        <text class="action-text">{{ formatCount(postInfo.reward_count) }}</text>
      </div>
      <div class="action-item" @click="openActionSheet">
        <div class="dots">
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
        <text class="action-text">更多</text>
      </div>
    </div>

    <!-- 底部信息面板 -->
    <div class="info-panel">
      <div class="author-line">
        <text class="author-name">@{{ postInfo.name || postInfo.nickname || '匿名' }}</text>
      </div>
      <div class="content-info">
        <text v-if="postInfo.title" class="title">{{ postInfo.title }}</text>
        <text v-if="postInfo.plain_content || postInfo.content" class="desc">{{ postInfo.plain_content || postInfo.content }}</text>
      </div>
    </div>

    <!-- 评论输入条 -->
    <div class="comment-entry" @click="openCommentDrawer">
      <div class="comment-pill">
        <text class="comment-placeholder">说点什么...</text>
      </div>
    </div>

    <!-- 评论抽屉 -->
    <div v-if="showCommentDrawer" class="drawer-mask" @click="closeCommentDrawer">
      <div class="drawer-content" @click="noop">
        <div class="drawer-handle"></div>
        <div class="drawer-header">
          <text class="drawer-title">评论 {{ commentCount }}</text>
          <text class="drawer-close" @click="closeCommentDrawer">关闭</text>
        </div>
        <scroller class="comment-list" :scroll-y="true">
          <div v-for="(item, idx) in comments" :key="idx" class="comment-item">
            <image class="comment-avatar" :src="item.avatar || '/static/logo.png'" mode="aspectFill"></image>
            <div class="comment-body">
              <text class="comment-name">{{ item.name || item.nickname || '匿名' }}</text>
              <text class="comment-text">{{ item.content }}</text>
              <div class="comment-footer">
                <text class="comment-time">{{ formatTime(item.create_time) }}</text>
                <text class="comment-reply">回复</text>
              </div>
            </div>
          </div>
          <div v-if="comments.length === 0" class="empty-comment">
            <text class="empty-text">暂无评论，快来抢沙发</text>
          </div>
        </scroller>
        <div class="comment-input-bar">
          <input
            class="comment-input"
            placeholder="说点什么..."
            placeholder-color="#999999"
            :value="commentText"
            @input="onCommentInput"
            @confirm="sendComment"
          />
          <div class="comment-send" @click="sendComment">
            <text class="send-text">发送</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 打赏弹窗 -->
    <div v-if="showReward" class="reward-mask" @click="closeReward">
      <div class="reward-content" @click="noop">
        <text class="reward-title">打赏作者</text>
        <div class="reward-amounts">
          <div v-for="(amount, idx) in rewardAmounts" :key="idx"
               class="reward-amount-item"
               :class="{ active: selectedReward === amount }"
               @click="selectedReward = amount">
            <text class="reward-amount-text">{{ amount }}</text>
          </div>
        </div>
        <div class="reward-buttons">
          <div class="reward-cancel" @click="closeReward"><text class="cancel-text">取消</text></div>
          <div class="reward-confirm" @click="confirmReward"><text class="confirm-text">打赏</text></div>
        </div>
      </div>
    </div>

    <!-- 操作菜单 -->
    <div v-if="showAction" class="action-mask" @click="closeAction">
      <div class="action-content" @click="noop">
        <div class="action-item-sheet" @click="sharePost"><text class="action-text-sheet">分享</text></div>
        <div class="action-item-sheet" @click="copyLink"><text class="action-text-sheet">复制链接</text></div>
        <div class="action-item-sheet cancel" @click="closeAction"><text class="action-text-sheet">取消</text></div>
      </div>
    </div>
  </div>
</template>

<script>
import { themeState } from '../../common/theme.js'

const API_BASE = 'http://example.com/api/index.php/'

export default {
  data() {
    return {
      postId: '',
      postInfo: {},
      isPlaying: false,
      isLiked: false,
      commentCount: 0,
      comments: [],
      commentText: '',
      showCommentDrawer: false,
      showReward: false,
      showAction: false,
      rewardAmounts: [10, 50, 100, 500, 1000],
      selectedReward: 10,
      statusBarHeight: 20,
      showFollowBtn: true
    }
  },
  computed: {
    themeClass() { return `theme-${themeState.effectiveTheme}` }
  },
  created() {
    const sys = uni.getSystemInfoSync()
    this.statusBarHeight = sys.statusBarHeight || 20
    // 先从storage读真实数据兜底
    const cached = uni.getStorageSync('currentVideoPost')
    if (cached) {
      this.applyPostInfo(cached)
    }
    uni.$on('postInfo', this.onPostInfo)
    uni.$on('playState', this.onPlayState)
    uni.$on('videoClick', this.onVideoClick)
  },
  beforeDestroy() {
    uni.$off('postInfo', this.onPostInfo)
    uni.$off('playState', this.onPlayState)
    uni.$off('videoClick', this.onVideoClick)
  },
  methods: {
    noop() {},
    applyPostInfo(info) {
      this.postInfo = info || {}
      this.postId = info.id || info.post_id || ''
      this.isLiked = !!(info.is_liked || info.isLiked)
      this.commentCount = Number(info.comment_count) || 0
      this.showFollowBtn = !info.is_follow && !info.isFollowing
    },
    onPostInfo(info) {
      this.applyPostInfo(info)
    },
    onPlayState(playing) {
      this.isPlaying = playing
    },
    onVideoClick() {
      this.togglePlay()
    },
    togglePlay() {
      uni.$emit('togglePlay')
    },
    goBack() {
      uni.$emit('goBack')
    },
    toUserHome() {
      const uid = this.postInfo.user_id || this.postInfo.userId
      if (uid) {
        uni.navigateTo({ url: '/pages/user/profile?id=' + uid })
      }
    },
    async handleFollow() {
      this.showFollowBtn = false
      uni.showToast({ title: '关注成功', icon: 'success' })
    },
    async handleLike() {
      if (this.isLiked) {
        this.postInfo.like_count = (Number(this.postInfo.like_count) || 0) - 1
        this.isLiked = false
      } else {
        this.postInfo.like_count = (Number(this.postInfo.like_count) || 0) + 1
        this.isLiked = true
      }
      try {
        await uni.request({
          url: API_BASE + 'post/like',
          method: 'POST',
          data: { post_id: this.postId, id: this.postId }
        })
      } catch (e) {}
    },
    openCommentDrawer() {
      this.showCommentDrawer = true
      this.loadComments()
    },
    closeCommentDrawer() {
      this.showCommentDrawer = false
    },
    async loadComments() {
      try {
        const res = await uni.request({
          url: API_BASE + 'comment/list?post_id=' + this.postId + '&id=' + this.postId,
          method: 'GET'
        })
        const data = res[0] && res[0].data ? res[0].data : {}
        if (data.code === 0) {
          this.comments = data.data || data.list || data.comments || []
        }
      } catch (e) {}
    },
    onCommentInput(e) {
      this.commentText = e.detail.value
    },
    async sendComment() {
      if (!this.commentText.trim()) {
        uni.showToast({ title: '请输入评论内容', icon: 'none' })
        return
      }
      try {
        const res = await uni.request({
          url: API_BASE + 'comment/send',
          method: 'POST',
          data: { post_id: this.postId, id: this.postId, content: this.commentText }
        })
        const data = res[0] && res[0].data ? res[0].data : {}
        if (data.code === 0) {
          uni.showToast({ title: '评论成功', icon: 'success' })
          this.commentText = ''
          this.commentCount++
          this.loadComments()
        } else {
          uni.showToast({ title: data.msg || '评论失败', icon: 'none' })
        }
      } catch (e) {
        uni.showToast({ title: '评论失败', icon: 'none' })
      }
    },
    openRewardModal() {
      this.showReward = true
    },
    closeReward() {
      this.showReward = false
    },
    async confirmReward() {
      try {
        const res = await uni.request({
          url: API_BASE + 'post/reward',
          method: 'POST',
          data: { post_id: this.postId, id: this.postId, amount: this.selectedReward }
        })
        const data = res[0] && res[0].data ? res[0].data : {}
        if (data.code === 0) {
          uni.showToast({ title: '打赏成功', icon: 'success' })
          this.postInfo.reward_count = (Number(this.postInfo.reward_count) || 0) + 1
          this.closeReward()
        } else {
          uni.showToast({ title: data.msg || '打赏失败', icon: 'none' })
        }
      } catch (e) {
        uni.showToast({ title: '打赏失败', icon: 'none' })
      }
    },
    openActionSheet() {
      this.showAction = true
    },
    closeAction() {
      this.showAction = false
    },
    sharePost() {
      this.closeAction()
      uni.showToast({ title: '分享功能开发中', icon: 'none' })
    },
    copyLink() {
      this.closeAction()
      uni.setClipboardData({
        data: 'http://example.com/post/' + this.postId,
        success: () => {
          uni.showToast({ title: '链接已复制', icon: 'success' })
        }
      })
    },
    formatCount(n) {
      const num = Number(n) || 0
      if (num >= 10000) return (num / 10000).toFixed(1) + 'w'
      if (num >= 1000) return (num / 1000).toFixed(1) + 'k'
      return String(num)
    },
    formatTime(t) {
      if (!t) return ''
      const d = new Date(String(t).replace(/-/g, '/'))
      const now = new Date()
      const diff = (now - d) / 1000
      if (diff < 60) return '刚刚'
      if (diff < 3600) return Math.floor(diff / 60) + '分钟前'
      if (diff < 86400) return Math.floor(diff / 3600) + '小时前'
      if (diff < 2592000) return Math.floor(diff / 86400) + '天前'
      return String(t).substring(0, 10)
    }
  }
}
</script>

